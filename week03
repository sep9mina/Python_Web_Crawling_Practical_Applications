scores = [80, "", 90, "", 60, 100]

total = 0
count = 0

for score in scores:
    try:
        # 嘗試將資料轉為整數（或浮點數）並進行累加
        total += int(score)
        count += 1
    except ValueError:
        # 如果是空字串 ""，int("") 會引發 ValueError，在此跳過不處理
        pass

print(f"有效資料個數: {count}")
print(f"有效資料加總: {total}")
